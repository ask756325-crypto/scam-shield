# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
PUBLIC_URL=https://scamshield.example.com
SCAMSHIELD_USER_AGENT=ScamShieldAI/1.0 (+https://scamshield.example.com; security@example.com)
# Email (password reset, verification, invites, alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional secrets
MASTODON_ACCESS_TOKENS=
YOUTUBE_API_KEY=
METRICS_TOKEN=
