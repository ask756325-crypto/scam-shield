# Copy to backend/.env and adjust. All settings use the SCAMSHIELD_ prefix.
SCAMSHIELD_ENV=development
# SQLite is used by default (backend/data/scamshield.db). For PostgreSQL:
# SCAMSHIELD_DATABASE_URL=postgresql+psycopg://scamshield:password@localhost:5432/scamshield
SCAMSHIELD_FRONTEND_ORIGIN=http://localhost:3000
SCAMSHIELD_SCHEDULER_ENABLED=true
SCAMSHIELD_SCHEDULER_TICK_SECONDS=60
# Production: set SCAMSHIELD_SCHEDULER_ENABLED=false on API replicas and run `python -m app.worker` once.
SCAMSHIELD_SCHEDULER_MAX_CONCURRENT_SCANS=2
SCAMSHIELD_RESOLVE_AFTER_MISSES=2
# Optional SMTP for password-reset email (otherwise reset links go to the server log in development):
# SCAMSHIELD_SMTP_HOST=smtp.example.com
# SCAMSHIELD_SMTP_PORT=587
# SCAMSHIELD_SMTP_USER=
# SCAMSHIELD_SMTP_PASSWORD=
# SCAMSHIELD_SMTP_FROM=alerts@example.com

# Local development test account used by scripts/seed_demo.py (never use in production).
SEED_EMAIL=analyst@example.com
SEED_PASSWORD=nv-ifOC5YXvO3wb7
SEED_NAME=Demo Analyst
SEED_ORG=Northvale Security (Demo)

# Optional secret: per-instance Mastodon access tokens (read:search scope). Server-side only; never commit real values.
# SCAMSHIELD_MASTODON_ACCESS_TOKENS=mastodon.social=REPLACE_ME
# SCAMSHIELD_YOUTUBE_API_KEY=REPLACE_ME          # optional secret: enables the YouTube source
# SCAMSHIELD_METRICS_TOKEN=REPLACE_ME            # optional secret: enables GET /api/metrics (Prometheus)
SCAMSHIELD_RATE_LIMIT_BACKEND=database
